<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- El tipo en la ficha del diario, debajo del tipo contable. -->
    <record id="view_account_journal_form_ingreso_tipo" model="ir.ui.view">
        <field name="name">account.journal.form.yaguven.ingreso.tipo</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="yaguven_ingreso_tipo"/>
            </xpath>
        </field>
    </record>

    <!-- Lista editable para configurar todos los diarios de una vez. -->
    <record id="view_account_journal_list_ingreso_tipo" model="ir.ui.view">
        <field name="name">account.journal.list.yaguven.ingreso.tipo</field>
        <field name="model">account.journal</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Tipos de ingreso por diario" editable="top" create="false" delete="false">
                <field name="name" readonly="1"/>
                <field name="type" readonly="1"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                <field name="operating_unit_id" readonly="1" optional="show"/>
                <field name="yaguven_ingreso_tipo"/>
            </list>
        </field>
    </record>

    <record id="action_account_journal_ingreso_tipo" model="ir.actions.act_window">
        <field name="name">Configurar Tipos de Ingreso</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_account_journal_list_ingreso_tipo"/>
        <field name="domain">[('type', 'in', ('cash', 'bank', 'credit', 'general'))]</field>
    </record>

    <menuitem
        id="menu_account_journal_ingreso_tipo"
        name="Configurar Tipos de Ingreso"
        parent="account.menu_finance_configuration"
        action="action_account_journal_ingreso_tipo"
        sequence="91"/>

</odoo>
